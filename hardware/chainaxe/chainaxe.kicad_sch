	(text "FAN CONTROL — 4x ANTHAT-STYLE 12V 4-WIRE"
		(exclude_from_sim no)
		(at 50.8 424.18 0.0000)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
		)
		(uuid "15d90a64-98d5-401c-9980-d86282122fcc")
	)
	(text "DANGER / S21 ASSEMBLY RULE: leave R90 RESET_ENABLE_LINK OPEN/DNP. Firmware must also never enable U12. Hardware safety is not firmware-only."
		(exclude_from_sim no)
		(at 690.88 370.84 0.0000)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
		)
		(uuid "f5a9b96f-246b-4977-be06-15fa5908026c")
	)
	(text "SAFE STARTUP: R105 keeps FAN_ARM=0 and R106-R109 hold U8 PWM inputs low; sinks stay released/full-speed-safe. HB_3V3=OFF; U6/U7/U12 disabled or high-Z. Prove every state on hardware."
		(exclude_from_sim no)
		(at 690.88 386.08 0.0000)
		(effects
			(font
				(size 1.5 1.5)
			)
		)
		(uuid "75a7ef2c-3e60-4ed7-90c6-04360453fd96")
	)
	(text "NO PSU CONTROL ON REV A.1. Hashboard core power remains external; an interface fault cannot guarantee removal of ASIC core power."
		(exclude_from_sim no)
		(at 690.88 401.32 0.0000)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
		)
		(uuid "db228119-c2b2-49fb-9e55-a6570a8f1df3")
	)
	(text "J1/fan copper is high current. External fuse required near source. Select FET count, connector, copper, and thermals from measured simultaneous startup/stall current."
		(exclude_from_sim no)
		(at 50.8 731.52 0.0000)
		(effects
			(font
				(size 1.5 1.5)
			)
		)
		(uuid "18868f07-42a8-4c81-a19b-f7740b809a37")
	)
	(text "FAN PROFILE RULE: supported 4-wire fans must include their own PWM pull-up. ChainAxe provides open-drain sinks only; fans needing an external pull-up are unsupported."
		(exclude_from_sim no)
		(at 50.8 739.14 0.0000)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
		)
		(uuid "8ce5e567-8b95-417c-821b-e130815d24b3")
	)
	(text "HASHBOARD POWER RULE: J10 pin16 HB_3V3 is controller-sourced only through U5. Never externally drive or backfeed this rail while R51 QOD is populated."
		(exclude_from_sim no)
		(at 690.88 416.56 0.0000)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
		)
		(uuid "f3b221e7-2a60-40cc-853c-14961e8c2c38")
	)
	(text "All connector drawings are mating-face views. Continuity-check pin 1, keying, fan G/12/T/P, J10 positions 17/18 NC, and shared ground before power."
		(exclude_from_sim no)
		(at 50.8 746.76 0.0000)
		(effects
			(font
				(size 1.5 1.5)
			)
		)
		(uuid "181ff4ae-55cf-4596-89d2-b415b6878591")
	)
	(text "PROVISIONAL/TBD: J6 selection and all connector fit checks; AP64501 compensation/magnetics; TVS ratings; FET thermals; EMC2305 straps; exact S19/S21 profile."
		(exclude_from_sim no)
		(at 50.8 762 0.0000)
		(effects
			(font
				(size 1.5 1.5)
			)
		)
		(uuid "00a4135f-56dd-4fe7-88d7-8f674b2f37d7")
	)
	(text "JLCPCB intent: 4-layer, mostly 0402/0805; extended parts accepted; J1/J2-J5/J10 hand-install. Verify fresh manufacturer-drawing footprints with 1:1 prints."
		(exclude_from_sim no)
		(at 50.8 777.24 0.0000)
