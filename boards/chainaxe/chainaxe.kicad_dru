(version 2)

# BEGIN Backplane fab profile (regenerated by Backplane from the fab's published limits; edits between these lines are replaced)
# profile rev 2 of 2026-11-19, for a pcb board: 6 layers, 1 oz, 1.6 mm, enig; base-price limits
# clearance: every net class is at or above the fab's 0.09mm (https://jlcpcb.com/capabilities/pcb-capabilities, read 2026-11-19)
# track width: the fab's 0.09mm (https://jlcpcb.com/capabilities/pcb-capabilities, read 2026-11-19)
(rule "fab: track width"
	(constraint track_width (min 0.09mm)))

# via diameter: the project's 0.5mm is as strict as the fab's 0.45mm or stricter
# via hole: the project's 0.3mm is as strict as the fab's 0.2mm or stricter
# pad hole: the project's 0.3mm is as strict as the fab's 0.2mm or stricter
# non-plated hole: the fab's 0.5mm (https://jlcpcb.com/capabilities/pcb-capabilities, read 2026-11-19)
(rule "fab: non-plated hole"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
	(constraint hole_size (min 0.5mm)))

# via ring: the project's 0.1mm is as strict as the fab's 0.05mm or stricter
# plated hole ring: the fab's 0.15mm (https://jlcpcb.com/capabilities/pcb-capabilities, read 2026-11-19)
(rule "fab: plated hole ring"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint annular_width (min 0.15mm)))

# hole to hole: the project's 0.25mm is as strict as the fab's 0.2mm or stricter
# pad hole to pad hole: the fab's 0.45mm (https://jlcpcb.com/capabilities/pcb-capabilities, read 2026-11-19)
(rule "fab: pad hole to pad hole"
	(condition "A.Type == 'Pad' && B.Type == 'Pad'")
	(constraint hole_to_hole (min 0.45mm)))

# hole to copper: the project's 0.25mm is as strict as the fab's 0.2mm or stricter
# plated hole to copper: the fab's 0.28mm (https://jlcpcb.com/capabilities/pcb-capabilities, read 2026-11-19)
(rule "fab: plated hole to copper"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint hole_clearance (min 0.28mm)))

# copper to edge: the fab's 0.2mm (https://jlcpcb.com/capabilities/pcb-capabilities, read 2026-11-19)
(rule "fab: copper to edge"
	(constraint edge_clearance (min 0.2mm)))

# silkscreen text height: the fab's 1mm (https://jlcpcb.com/capabilities/pcb-capabilities, read 2026-11-19)
(rule "fab: silkscreen text height"
	(condition "A.Layer == 'F.SilkS' || A.Layer == 'B.SilkS'")
	(constraint text_height (min 1mm)))

# silkscreen text line: the fab's 0.15mm (https://jlcpcb.com/capabilities/pcb-capabilities, read 2026-11-19)
(rule "fab: silkscreen text line"
	(condition "A.Layer == 'F.SilkS' || A.Layer == 'B.SilkS'")
	(constraint text_thickness (min 0.15mm)))

# END Backplane fab profile

(rule "TPSM861253 land pattern"
	(condition "A.Parent == 'U2' && B.Parent == 'U2'")
	(constraint clearance (min 0.15mm))
)
